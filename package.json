{
  "name": "pg-genetics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "build:exe": "vite build && electron-packager . \"PG Genetics\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/src\" --ignore=\"^/release\" --ignore=\"^/node_modules\" --ignore=\"^/\\.git\" --ignore=\"^/\\.claude\" --ignore=\"\\.(md|map)$\"",
    "build:exe-portable": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId": "com.gorgongenetics.pg",
    "productName": "PG Genetics",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "PG-Genetics-${version}-portable.exe"
    }
  }
}
